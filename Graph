//BFS
class Solution {
    public ArrayList<Integer> bfsOfGraph(int V, ArrayList<ArrayList<Integer>> adj) {
        
        ArrayList<Integer> bfs = new ArrayList<>();
        boolean[] visited = new boolean[V];
        Queue<Integer> q = new LinkedList<>();
        
        // start from node 0
        q.add(0);
        visited[0] = true;
        
        while (!q.isEmpty()) {
            int node = q.poll();
            bfs.add(node);
            
            for (int neigh : adj.get(node)) {
                if (!visited[neigh]) {
                    visited[neigh] = true;
                    q.add(neigh);
                }
            }
        }
        
        return bfs;
    }
}
//DFS
import java.util.*;

class Solution {
    
    public ArrayList<Integer> dfsOfGraph(int V, ArrayList<ArrayList<Integer>> adj) {
        
        ArrayList<Integer> dfs = new ArrayList<>();
        boolean[] visited = new boolean[V];
        
        dfsHelper(0, adj, visited, dfs);
        
        return dfs;
    }
    
    void dfsHelper(int node, ArrayList<ArrayList<Integer>> adj,
                   boolean[] visited, ArrayList<Integer> dfs) {
        
        visited[node] = true;     // mark
        dfs.add(node);            // visit
        
        for (int neigh : adj.get(node)) {
            if (!visited[neigh]) {
                dfsHelper(neigh, adj, visited, dfs);
            }
        }
    }
}
//547. Number of Provinces
class Solution {
    public int findCircleNum(int[][] isConnected) {
        int n = isConnected.length;
        boolean [] visited = new boolean[n];
        int provinces =0;
        for(int i =0;i<n;i++){
            if(!visited[i]){
                dfs(i,isConnected,visited);
                provinces++;
            }
        }
        return provinces;
    }
    public void dfs(int node , int[][]isConnected,boolean[] visited){
        visited[node]=true;
        for(int j =0 ;j<isConnected.length;j++){
            if(!visited[j] && isConnected[node][j]==1){
                dfs(j,isConnected,visited);
            }
        }
    }
}
//994. Rotting Oranges
class Solution {
    static class Pair{
        int row ;
        int col;
        int time;
        Pair(int r, int c, int t){
            row = r;
            col = c;
            time =t;
        }
    }
    public int orangesRotting(int[][] grid) {
        int n = grid.length;
        int m = grid[0].length;
        int cntfsh =0;
        int [][] vis = new int [n][m];
        Queue <Pair> q = new LinkedList<>();
        for(int i = 0;i<n;i++){
            for(int j =0;j<m;j++){
                if(grid[i][j]==2){
                    q.add(new Pair(i,j,0));
                    vis[i][j]=2;
                }
                else{
                    vis[i][j]=0;
                }
                if(grid[i][j]==1) cntfsh++;
            }
        }
        int tm =0;
        int [] drow = {-1,0,1,0};
        int []dcol =  {0,1,0,-1};
        int cnt=0;
        while(!q.isEmpty()){
            Pair p = q.poll();
            int r =p.row;
            int c=p.col;
            int t = p.time;
            tm= Math.max(t,tm);
            for(int i=0;i<4;i++){
                int nrow = r + drow[i];
                int ncol = c + dcol[i];
                if( nrow >=0 && ncol>=0&&
                    nrow<n && ncol <m &&
                    vis[nrow][ncol]==0&&
                    grid[nrow][ncol]==1){
                        q.add(new Pair(nrow,ncol,t+1));
                        vis[nrow][ncol]=2;
                        cnt++;
                    } 
            }
        }
        if(cnt != cntfsh) return -1;
        return tm;
    }
}
// 733. Flood Fill
class Solution {
    public int[][] floodFill(int[][] image, int sr, int sc, int color) {
      int oldclr = image[sr][sc];
      if(oldclr == color) return image;
      dfs(image,sr,sc,oldclr,color);
      return image;  
    }
    public void dfs(int[][]image,int r,int c,int old ,int col){
        if(r>=image.length || c>=image[0].length ||r<0||c<0 ||image[r][c] != old) return ;
        image[r][c]=col;
        dfs(image,r-1,c,old,col);
        dfs(image,r,c-1,old,col);
        dfs(image,r+1,c,old,col);
        dfs(image,r,c+1,old,col);
    }
}
