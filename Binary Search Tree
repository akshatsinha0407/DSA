class Solution {
    public TreeNode insertIntoBST(TreeNode root, int val) {
        TreeNode node = root;

        if (root == null) return new TreeNode(val);

        while (node != null) {
            if (val < node.val) {
                if (node.left == null) {
                    node.left = new TreeNode(val);
                    break;
                }
                node = node.left;
            } else {
                if (node.right == null) {
                    node.right = new TreeNode(val);
                    break;
                }
                node = node.right;
            }
        }

        return root;
    }
}
