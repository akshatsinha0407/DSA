class Solution {
    public TreeNode deleteNode(TreeNode root, int key) {
        if(root == null) return null;
        if(key<root.val){
            root.left = deleteNode(root.left,key);
        }
        else if(key>root.val){
           root.right = deleteNode(root.right,key);
        }
        else{
            if(root.left == null){
                return root.right;
            }
            if(root.right == null){
                return root.left;
            }
            int sucssor = getsucssor(root.right);
            root.val = sucssor;
            root.right = deleteNode(root.right,sucssor);
        }
        return root;
    }
    public int getsucssor(TreeNode root){
        while(root.left!=null){
            root=root.left;
        }
        return root.val;
    }
}
