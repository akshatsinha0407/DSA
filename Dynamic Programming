class Solution {

    static Boolean isSubsetSum(int arr[], int sum) {

        int n = arr.length;

        boolean[] prev = new boolean[sum + 1];

        prev[0] = true;

        if(arr[0] <= sum){
            prev[arr[0]] = true;
        }

        for(int i = 1; i < n; i++){

            boolean[] curr = new boolean[sum + 1];
            curr[0] = true;

            for(int t = 1; t <= sum; t++){

                boolean notTake = prev[t];

                boolean take = false;

                if(arr[i] <= t){
                    take = prev[t - arr[i]];
                }

                curr[t] = take || notTake;
            }

            prev = curr;
        }

        return prev[sum];
    }
}
