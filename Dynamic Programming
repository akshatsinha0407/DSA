class Solution {
    public boolean canPartition(int[] nums) {
        int totalsum = 0;
        for (int i = 0; i < nums.length; i++) {
            totalsum += nums[i];
        }
        if (totalsum % 2 != 0)
            return false;
        return solve(nums, totalsum / 2);
    }

    private boolean solve(int nums[], int sum) {
        boolean[] prev = new boolean[sum + 1];
        prev[0] = true;
        if (nums[0] <= sum) {
            prev[nums[0]] = true;
        }
        for (int i = 1; i < nums.length; i++) {
            boolean curr[] = new boolean[sum + 1];
            curr[0] = true;
            for (int t = 1; t <= sum; t++) {
                boolean not = prev[t];
                boolean take = false;
                if (nums[i] <= t) {
                    take = prev[t - nums[i]];
                }
                curr[t] = take || not;
            }
            prev = curr;
        }
        return prev[sum];
    }
}
