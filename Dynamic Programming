class Solution {

    public int frogJump(int[] height){

        int n = height.length;

        int prev = 0;
        int prev2 = 0;

        for(int i = 1; i < n; i++){

            int oneJump = prev 
                          + Math.abs(height[i] - height[i-1]);

            int twoJump = Integer.MAX_VALUE;

            if(i > 1){
                twoJump = prev2 
                          + Math.abs(height[i] - height[i-2]);
            }

            int curr = Math.min(oneJump, twoJump);

            prev2 = prev;
            prev = curr;
        }

        return prev;
    }
}
