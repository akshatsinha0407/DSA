class Solution {
    public int minimumTotal(List<List<Integer>> triangle) {

        int n = triangle.size();
        int[][] dp = new int[n][n];

        // last row copy
        for(int j = 0; j < n; j++){
            dp[n-1][j] = triangle.get(n-1).get(j);
        }

        for(int i = n-2; i >= 0; i--){
            for(int j = 0; j <= i; j++){

                int down = dp[i+1][j];
                int diag = dp[i+1][j+1];

                dp[i][j] = triangle.get(i).get(j) + Math.min(down, diag);
            }
        }

        return dp[0][0];
    }
}
