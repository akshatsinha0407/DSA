class Solution {
    public int concatenatedBinary(int n) {
        long ans =0;
        long mod = 1000000007;
        int bit =0;
        for(int i =1 ;i<=n ;i++){
            if((i&(i-1))==0){
                bit++;
            }
            ans = ((ans<<bit)%mod + i)%mod;
        }
        return (int) ans;
    }
}
