class Solution {
    public int countPrimeSetBits(int left, int right) {
        int count =0;
        for(int i = left ; i<=right ;i++){
            int setbit = Integer.bitCount(i);
            if(isPrime(setbit)){
                count++;
            }
        }
        return count;
    }
    public boolean isPrime(int n){
        if(n<2) return false;
        for(int i =2;i*i<=n;i++){
            if(n%i==0) return false;
        }
        return true;

       }
}
