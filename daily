class Solution {
    public int binaryGap(int n) {
        int lastPos = -1;   
        int maxGap = 0;
        int index = 0;      

        while (n > 0) {
            if ((n & 1) == 1) {   
                if (lastPos != -1) {
                    maxGap = Math.max(maxGap, index - lastPos);
                }
                lastPos = index;
            }
            index++;
            n = n >> 1;  
        }

        return maxGap;
    }
}
